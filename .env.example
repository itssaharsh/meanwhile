# ---------------------------------------------------------------------------
# BACKEND — set these as Convex environment variables, NOT in a committed .env:
#   npx convex env set OPENAI_KEY sk-...
#   npx convex env set --from-file .env.convex     # or set several at once
# ---------------------------------------------------------------------------

# --- vision provider (any OpenAI-compatible API) ----------------------------
# The only credential the live channel actually needs. Without it, cameras are
# still fetched but nothing is scored — and nothing is written, rather than a
# fabricated score being persisted.
#
# Pick a provider by name and the base URL + default model come from
# convex/providers.ts:
#   npx convex env set AI_PROVIDER gemini          # gemini (default) | openai | openrouter
#   npx convex env set OPENAI_API_KEY <key>
#
# …or set the base URL yourself, which wins over AI_PROVIDER's default:
#   npx convex env set OPENAI_BASE_URL https://generativelanguage.googleapis.com/v1beta/openai
#   npx convex env set OPENAI_MODEL gemini-2.5-flash
#
# Callers can also bring their own: score:scoreSnapshot and countries:fetchCountry
# take optional {provider, apiKey, model} that override all of this for one call.
# A caller-supplied key is used for that request and then dropped — never logged,
# never stored.
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_BASE_URL=
# OPENAI_KEY is still read as a fallback for older deployments.
OPENAI_KEY=

# Firecrawl is demand-driven — never called per camera on the cron. It powers the
# country click (search + screenshot + narration) and one cached headline for the
# snapshot currently on air. Note: its free tier is ~500 credits TOTAL.
FIRECRAWL_KEY=

# Only needed for cameras whose source is "windy".
WINDY_KEY=

# Only needed for the "email me this moment" button. AGENTMAIL_INBOX has no
# default — an inbox you don't own just 404s.
AGENTMAIL_KEY=
AGENTMAIL_INBOX=

# Signing secret (whsec_...) of the AgentMail webhook pointed at /agentmail/webhook.
# Until it is set the webhook refuses events (503), and AgentMail retries them later.
AGENTMAIL_WEBHOOK_SECRET=

# The cron kill switch. The 20-minute refresh is a no-op until this is exactly "1",
# so pushing the code (which happens before any key exists) never spends anything.
#   npx convex env set POOL_ENABLED 1
POOL_ENABLED=

# Optional: cap how many cameras one refresh touches (0 / unset = all active).
POOL_MAX_CAMERAS=

# How long a local headline is reused before Firecrawl is asked again (default 6).
# Headlines move far slower than webcam frames: at 6h an 11-camera pool costs ~44
# searches/day instead of ~790. Raise it to stretch a free tier further.
HEADLINE_TTL_HOURS=

# Optional: the PREFERRED model, tried first. For Gemini the failover chain in
# convex/providers.ts is the fallback order after it; leave unset to start at the
# head of the chain (gemini-3.5-flash-lite, the most daily headroom).
OPENAI_MODEL=

# Set to "1" to hard-block every vision AND Firecrawl call server-side, whatever
# else is configured.
# Belt-and-braces for a demo deployment: the frontend's ?demo=true already makes no
# backend calls at all, so this covers the case where someone hits the API directly.
DEMO_MODE=

# ---------------------------------------------------------------------------
# FRONTEND — this one lives in .env.local, which `npx convex dev` writes for you.
# Vite reads it at build time; it is not a secret.
# ---------------------------------------------------------------------------
# VITE_CONVEX_URL=https://your-deployment.convex.cloud
